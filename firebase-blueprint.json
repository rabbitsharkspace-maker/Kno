{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription data",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "displayName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and subscription details"
    },
    "/users/{userId}/appData/{docId}": {
      "schema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "chunks": {
            "type": "number"
          }
        }
      },
      "description": "Stores user app data like inbox, library, canvases, etc."
    }
  }
}